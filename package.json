{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve": "php artisan serve --host=0.0.0.0 --port=8000",
        "queue": "php artisan queue:listen",
        "reverb": "php artisan reverb:start",
        "dev:all": "concurrently --kill-others --names SERVER,VITE,QUEUE,REVERB --prefix-colors blue,green,yellow,magenta \"npm:serve\" \"npm:dev\" \"npm:queue\" \"npm:reverb\""
    },
    "overrides": {
        "shell-quote": "1.8.4"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.2.4",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "pusher-js": "^8.5.0",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    }
}
