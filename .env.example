APP_NAME=LearnForge
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
APP_BASE_DOMAIN=localhost
APP_TENANT_SCHEME=https

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=learnforge_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MEDIA_DISK=media_local
MEDIA_STORAGE_BUCKET=local-media
MEDIA_SIGNED_URL_TTL_MINUTES=10
MEDIA_MAX_UPLOAD_KILOBYTES=1048576
MEDIA_AWS_ACCESS_KEY_ID=
MEDIA_AWS_SECRET_ACCESS_KEY=
MEDIA_AWS_DEFAULT_REGION=
MEDIA_AWS_BUCKET=
MEDIA_AWS_ENDPOINT=
MEDIA_AWS_USE_PATH_STYLE_ENDPOINT=false
# Media processing providers.
#
# Bo trong = chua cau hinh. Khi do virus_scan tra 'provider_unavailable', va vi
# virus_scan la job bat buoc cho moi file type, file vua upload se chuyen
# 'failed' va bi tra 404 khi delivery. Day la hanh vi fail-closed co chu y,
# khong phai loi.
#
# Local dev: dat 'fake' de chay duoc dau-cuoi.
#
#   MEDIA_VIRUS_SCAN_PROVIDER=fake
#   MEDIA_VIRUS_SCAN_VERSION=fake-v1
#
# CANH BAO: 'fake' KHONG quet virus va KHONG goi provider that. No chi dung cho
# development va test. Production bat buoc dung provider that da duoc duyet va
# cap credential — xem docs/platform/LF-Media-Processing-Contract.md.
MEDIA_VIRUS_SCAN_PROVIDER=
MEDIA_OCR_PROVIDER=
MEDIA_SPEECH_TO_TEXT_PROVIDER=
MEDIA_CAPTION_PROVIDER=
MEDIA_THUMBNAIL_PROVIDER=
MEDIA_TRANSCODE_PROVIDER=
MEDIA_STRUCTURED_EXTRACTION_PROVIDER=

# Phien ban extractor/provider/model. Doi gia tri nay = revision moi:
# output cu chuyen 'archived', khong bi ghi de.
MEDIA_VIRUS_SCAN_VERSION=
MEDIA_OCR_VERSION=
MEDIA_SPEECH_TO_TEXT_VERSION=
MEDIA_CAPTION_VERSION=
MEDIA_STRUCTURED_EXTRACTION_VERSION=docling-2.119.0-layout-v7-poppler-bbox

# Local/self-hosted document extraction (PDF/Office/TXT). This provider uses
# real local binaries; it is not the fake test provider.
# MEDIA_OCR_PROVIDER=local_document
# MEDIA_OCR_VERSION=local-document-v1
MEDIA_PDFTOTEXT_BINARY=pdftotext
MEDIA_PDFTOPPM_BINARY=pdftoppm
MEDIA_PDFINFO_BINARY=pdfinfo
MEDIA_TESSERACT_BINARY=tesseract
MEDIA_SOFFICE_BINARY=soffice
MEDIA_DOCUMENT_COMMAND_TIMEOUT_SECONDS=300
MEDIA_OFFICE_TIMEOUT_SECONDS=900
MEDIA_DOCUMENT_MAX_PROCESSING_SECONDS=3300
MEDIA_DOCUMENT_MAX_PAGES=100
MEDIA_DOCX_MAX_XML_BYTES=8000000
MEDIA_OCR_DPI=200
MEDIA_MAX_EXTRACTED_CHARACTERS=500000

# A1 structured layout. `docling_local` is offline and does not replace OCR.
# MEDIA_STRUCTURED_EXTRACTION_PROVIDER=docling_local
# MEDIA_STRUCTURED_EXTRACTION_VERSION=docling-2.119.0-layout-v6-evidence
# Speech-to-text Phase 1: adapter local, khong goi provider ngoai.
# MEDIA_SPEECH_TO_TEXT_PROVIDER=faster_whisper_local
# MEDIA_SPEECH_TO_TEXT_VERSION=faster-whisper-1.2.1-small-int8
# MEDIA_STT_MAX_BYTES=1073741824
# MEDIA_STT_MAX_DURATION_SECONDS=7200
# MEDIA_STT_TIMEOUT_SECONDS=3300

# Video STT: mac dinh TAT cho toi khi DOC-CONFLICT-0027 dong — tran thoi luong
# hien la provisional, do tren may dev dang thermal throttle.
# MEDIA_VIDEO_STT_ENABLED=false
# MEDIA_FFMPEG_BINARY=/usr/local/bin/ffmpeg
# ffmpeg version la INVENTORY cua deployment, khong phai ket qua probe. Worker
# kiem binary that khop gia tri nay truoc khi xu ly; lech thi fail-closed.
# MEDIA_FFMPEG_VERSION=7.1.1
# Production: evidence PASS còn hạn và khớp processing identity hiện hành.
# MEDIA_VIDEO_STT_QUALIFICATION_REQUIRED=true
# MEDIA_VIDEO_STT_QUALIFICATION_EVIDENCE=/etc/learnforge/video-stt-qualification.json
# MEDIA_VIDEO_AUDIO_TIMEOUT_SECONDS=600
# MEDIA_STT_PYTHON_BINARY=/absolute/path/to/runtime/stt/.venv/bin/python
# MEDIA_STT_SCRIPT=/absolute/path/to/runtime/stt/transcribe.py
# MEDIA_STT_MODEL_PATH=/absolute/path/to/runtime/stt/models/small
# MEDIA_STT_COMPUTE_TYPE=int8
# MEDIA_STT_THREADS=0
# MEDIA_STT_MAX_OUTPUT_BYTES=16777216

# MEDIA_STRUCTURED_CROP_ENABLED=true
# MEDIA_STRUCTURED_CROP_DPI=200
# MEDIA_STRUCTURED_CROP_OCR_ENABLED=true
# MEDIA_STRUCTURED_CROP_OCR_MIN_TEXT_CHARACTERS=2
# Tran do bang benchmark that: 300 figure/100 trang = 14 MB o 200 DPI.
# MEDIA_STRUCTURED_MAX_CROP_BYTES_PER_DOCUMENT=67108864
MEDIA_DOCLING_PYTHON_BINARY=
MEDIA_DOCLING_ARTIFACTS_PATH=
MEDIA_DOCLING_TIMEOUT_SECONDS=3300
MEDIA_DOCLING_MAX_OUTPUT_BYTES=67108864
MEDIA_STRUCTURED_MAX_PAGES=100
MEDIA_STRUCTURED_MAX_EXTRACTED_CHARACTERS=500000
MEDIA_STRUCTURED_MAX_REGIONS_PER_PAGE=100
MEDIA_STRUCTURED_MAX_REGIONS_PER_DOCUMENT=5000
MEDIA_STRUCTURED_MAX_TABLE_CELLS_PER_DOCUMENT=200000
MEDIA_STRUCTURED_MAX_PROCESSING_SECONDS=3300
MEDIA_STRUCTURED_COMMAND_TIMEOUT_SECONDS=900

# Phải lớn hơn ProcessMediaProcessingJob::$timeout (3600 giây), nếu không Redis
# có thể phát lại cùng job trong khi worker đầu tiên vẫn đang OCR.
REDIS_QUEUE_RETRY_AFTER=3900
DB_QUEUE_RETRY_AFTER=3900
BEANSTALKD_QUEUE_RETRY_AFTER=3900

CACHE_STORE=redis

QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=learnforge
REVERB_APP_KEY=learnforge_key
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
