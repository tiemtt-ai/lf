{
  "contract": {
    "max_pages": 100,
    "max_extracted_characters": 500000,
    "max_docx_xml_bytes": 8000000,
    "ocr_dpi": 200,
    "max_processing_seconds": 3300,
    "command_timeout_seconds": 300,
    "office_timeout_seconds": 900
  },
  "locales": {
    "vi": ["vie", "eng"],
    "ko": ["kor", "eng"],
    "en": ["eng"]
  },
  "gates": {
    "boundary_score_min": 0.85,
    "reading_order_tau_min": 0.95,
    "p95_seconds_per_page_max": 33.0,
    "p99_document_seconds_max": 3300.0,
    "vi_cer_raw_max": null,
    "vi_cer_diacritic_stripped_max": null,
    "ko_cer_max": null,
    "page_coverage_min": null
  },
  "binaries": {
    "pdfinfo": "pdfinfo",
    "pdftotext": "pdftotext",
    "pdftoppm": "pdftoppm",
    "tesseract": "tesseract",
    "soffice": "soffice"
  },
  "docling": {
    "package_version": "2.119.0",
    "ocr_engine": "tesseract_cli",
    "artifacts_path": "models",
    "offline": true,
    "enable_remote_services": false,
    "allow_external_plugins": false,
    "accelerator_device": "cpu",
    "compile_layout_model": false,
    "force_full_page_ocr": false,
    "do_table_structure": true
  }
}
